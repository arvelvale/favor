# Copy to .env in this directory. Use NEW credentials, never values from Git history.
# Required: the application stops at startup if any of these values is empty.
DEEPSEEK_API_KEY=
SECRET_KEY=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=recipe_app

# No default administrator account. Paste the hash produced by scripts/configure_admin.py.
# No username or hash means administrator login is disabled.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Optional service credentials: each missing pair disables its service.
GEMINI_API_KEY=
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_NAME=Flavor Fusion
FEEDBACK_EMAIL=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# No development proxy or debugger is enabled by default.
HTTP_PROXY=
HTTPS_PROXY=
DEBUG=false
PORT=5000
