# 复制为同目录下的 .env 后填写。不要把真实凭据提交进 Git。

# 必填：会话签名密钥，至少 32 个字符。生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 模型服务（OpenAI 兼容接口，默认 DeepSeek）。不填时应用照常运行，只是对话功能不可用。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# DeepSeek V4.1 Flash（推理模型，支持工具调用）。旧的 deepseek-chat 已不在模型列表中
LLM_MODEL=deepseek-flash

# 可选
DATABASE_PATH=
PORT=5000
DEBUG=false
# 通过 HTTPS 部署时设为 true
SECURE_COOKIES=false

# 营养知识库 RAG（本地 BM25 检索，无需外部服务，默认开启）。
# 关掉后 agent 看不到 search_nutrition 工具，回答不再引用知识库。
RAG_ENABLED=true
# 每次最多引用几个资料片段
RAG_TOP_K=4
# 检索最低分门槛：低于此分视为无可靠依据（默认 12.0 来自离线评测）
RAG_MIN_ABS_SCORE=12.0
# 排序精度（可选）：命中文档标题/小标题/标签的片段额外加分，让最相关的排第一。
# 这些分只在「已过门槛的候选内部」改变顺序，不影响是否判定为有依据，可安心保持默认。
RAG_TITLE_BOOST=2.0
RAG_HEADING_BOOST=0.8
RAG_TAG_BOOST=0.8
# 重排候选池 = top_k × 此倍数，默认 3 即可；调大可给重排更多候选，略增耗时。
RAG_RERANK_POOL_MULT=3
# 语料目录，留空用默认 server/rag/kb
RAG_KB_DIR=

# 菜品配图服务：IMAGE_PROVIDER 留空 = 自动（配了 MINIMAX_API_KEY 就用 MiniMax，否则用百炼）；也可写 minimax / dashscope 指定，写 off 关闭配图。
IMAGE_PROVIDER=
# MiniMax 文生图（image-01）。国际版账号把 MINIMAX_BASE_URL 换成 https://api.minimax.io/v1
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_IMAGE_MODEL=image-01

# 菜品配图（阿里云百炼 DashScope）。两家都不填时 agent 不会生成图片，其他功能不受影响。
DASHSCOPE_API_KEY=
IMAGE_MODEL=z-image-turbo
IMAGE_SIZE=1024*1024
# 每个用户每天最多生成几张（失败的不计）
IMAGE_DAILY_LIMIT=10
# 默认走北京地域公共入口；使用业务空间专属域名时改为 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# 拍冰箱照片识别食材（DeepSeek 视觉模型，OpenAI 兼容接口，默认复用上面的 LLM_API_KEY / LLM_BASE_URL）。
# 都没填密钥时前端不显示「拍一张」；如需单独指定识图服务，可填写 VISION_API_KEY / VISION_BASE_URL。
VISION_API_KEY=
VISION_MODEL=deepseek-flash
VISION_BASE_URL=
# 每个用户每天最多识别几次（失败也计入）
VISION_DAILY_LIMIT=20
